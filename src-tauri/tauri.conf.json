{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lineage",
  "version": "0.1.0",
  "identifier": "com.lineage.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "dashboard",
        "title": "Lineage",
        "url": "/",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "Lineage",
        "url": "/onboarding",
        "width": 780,
        "height": 400,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jam-Sw/lineage/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyOThFMDhBQ0Q5REJDRQpSV1RPMjltc0NJNHBEdlBqU0VVQ1JmdUtuaDlJOUZaUm9rUjVJNjJSZ0RRWStXWkdpR2VNRkFMUwo="
    }
  }
}
